# NaviFreight Maritime Intelligence Platform — Environment Configuration

# Optional: Firebase Authentication Credentials
# If left blank, NaviFreight operates in local authenticated sandbox mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API URL (default: http://localhost:3001)
VITE_API_BASE_URL=http://localhost:3001
